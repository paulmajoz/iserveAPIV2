# ── Server ────────────────────────────────────────────────────
PORT=3000

# ── MongoDB ───────────────────────────────────────────────────
# V2 database (primary — used by the API at runtime)
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster.mongodb.net/iserveza

# V1 database (only needed when running `npm run migrate`)
# If your V1 and V2 data live in the SAME database, you can leave this blank
# and the migrate script will fall back to MONGO_URI automatically.
MONGO_URI_V1=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@OLD_CLUSTER.mongodb.net/iserveza

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string

# ── SMTP (for sending QR code emails) ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Environment ───────────────────────────────────────────────
NODE_ENV=development
